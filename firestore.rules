rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // ACA CHURCH PKT — FIRESTORE SECURITY RULES
    // Master Security Policy: Public Read for site content, Admin-only write,
    // Public write-only for prayer requests with field validation.
    // =========================================================================

    // Whitelist of authorized church admin UIDs.
    // Replace with your real Firebase Authentication UIDs.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in [
          'ADMIN_UID_PRIMARY_TODO',
          'ADMIN_UID_SECONDARY_TODO'
        ]
        // Or if using custom claims: request.auth.token.admin == true
      );
    }

    // 1. Site Content (Single doc per section: hero, about, founder, serviceTimes, contact)
    match /site_content/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Vision Items (Collection of vision cards ordered by `order`)
    match /vision_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Prayer Categories (Collection of prayer types and schedules)
    match /prayer_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Gallery Images (Collection of Cloudinary image entries)
    match /gallery_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Prayer Requests (Public write-only petition inbox, Admin read/manage)
    match /prayer_requests/{requestId} {
      // Public can create petitions with required fields and payload limits
      allow create: if request.resource.data.keys().hasAll(['name', 'category', 'message', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 600
                    && request.resource.data.status in ['new', 'praying', 'resolved'];

      // Only authenticated admins can read petitions, update status, or delete
      allow read, update, delete: if isAdmin();
    }

    // Deny access to any other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
